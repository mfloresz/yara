{
  "manifest_version": 3,
  "name": "Yara Browser Worker Debug (Firefox)",
  "version": "1.0.0",
  "description": "Debug browser proxy for Yara - no auth required, for development only (Firefox)",
  "browser_specific_settings": {
    "gecko": {
      "id": "{75bbc18c-975f-49e8-a695-956f76881059}",
      "data_collection_permissions": {
        "required": ["websiteContent"]
      }
    }
  },
  "permissions": [
    "tabs",
    "activeTab",
    "storage",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background/firefox-background.js"]
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
