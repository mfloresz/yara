{
  "manifest_version": 3,
  "name": "Yara Browser Worker",
  "version": "1.0.1",
  "description": "Browser proxy for Yara - fetches pages through real browser to bypass Cloudflare (Firefox)",
  "browser_specific_settings": {
    "gecko": {
      "id": "{960af93a-08d6-481e-ac0e-26cc8f8a872e}",
      "data_collection_permissions": {
        "required": ["websiteContent", "authenticationInfo"]
      }
    }
  },
  "permissions": [
    "tabs",
    "activeTab",
    "storage",
    "scripting",
    "alarms",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background/firefox-background.js"]
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["auth/auth.html", "auth/auth.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
