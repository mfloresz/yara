{
  "manifest_version": 3,
  "name": "Yara Browser Worker (Firefox)",
  "version": "1.0.0",
  "description": "Browser proxy for Yara - fetches pages through real browser to bypass Cloudflare (Firefox)",
  "browser_specific_settings": {
    "gecko": {
      "id": "{720e4198-2455-4bf5-b973-378a8368a6a4}",
      "data_collection_permissions": {
        "required": ["websiteContent", "authenticationInfo"]
      }
    }
  },
  "permissions": [
    "tabs",
    "activeTab",
    "storage",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background/firefox-background.js"]
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["auth/auth.html", "auth/auth.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
